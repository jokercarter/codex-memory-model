{
  "mcpServers": {
    "codex-memory": {
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "scripts\\launch_codex_memory_mcp.cmd"
      ],
      "cwd": ".",
      "env_vars": [
        "PATH",
        "LOCALAPPDATA",
        "USERPROFILE",
        "CODEX_HOME",
        "CODEX_MEMORY_PYTHON",
        "CODEX_MEMORY_DB",
        "CODEX_MEMORY_SETTINGS"
      ],
      "tool_timeout_sec": 60
    }
  }
}
